<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


 <ImageView
     android:id="@+id/imageView3"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:scaleType="centerCrop"
     android:src="@drawable/background"
     android:contentDescription="Background Image" />


 <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:orientation="vertical">


  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:padding="16dp">

   <ImageView
       android:id="@+id/myImageView"
       android:layout_width="140dp"
       android:layout_height="54dp"
       android:contentDescription="@string/pizza_Image"
       android:src="@drawable/imgpiz" />

   <View
       android:layout_width="0dp"
       android:layout_height="4dp"
       android:layout_weight="2" />

   <Button
       android:id="@+id/orderBF"
       android:layout_width="101dp"
       android:layout_height="wrap_content"
       android:backgroundTint="#FFEB3B"
       android:text="@string/order_Button"
       android:textColor="@color/black" />

   <ImageView
       android:id="@+id/myMenuBtn"
       android:layout_width="41dp"
       android:layout_height="40dp"
       android:layout_marginStart="18dp"
       android:contentDescription="Menu Button"
       android:src="@drawable/menu" />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="vertical">

   <TextView
       android:id="@+id/myTitlePiz"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:text="@string/title_ScreenMain"
       android:textColor="@color/white"
       android:textSize="40sp" />

   <TextView
       android:id="@+id/miniTitle"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:textColor="@color/white"
       android:layout_marginTop="8dp"
       android:text="@string/h3_title"
       android:textSize="16sp" />

   <LinearLayout
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_marginTop="16dp"
       android:orientation="horizontal">

    <Button
        android:id="@+id/scMenuF"
        android:layout_width="125dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:backgroundTint="#FFEB3B"
        android:textColor="@color/black"
        android:text="@string/title_BrowseMenuPizza" />

    <Button
        android:id="@+id/scMenuF2"
        android:layout_width="125dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/black"
        android:backgroundTint="#FFEB3B"
        android:text="@string/title_BrowseMenuDrinks"  />
   </LinearLayout>
  </LinearLayout>

 </LinearLayout>

</FrameLayout>
