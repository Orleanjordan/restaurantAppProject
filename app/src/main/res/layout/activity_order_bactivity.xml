<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/background"
            android:contentDescription="Background" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Pizza Order"
                android:textColor="@color/white"
                android:textSize="27sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="15dp" />



            <ImageView
                android:id="@+id/pizzaImage"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:contentDescription="Selected Pizza" />

            <TextView
                android:id="@+id/pizzaNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pizza Name"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="10dp" />



            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose Size"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/sizeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/smallPizza"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Small (+$0.00)"
                    android:textColor="@color/white" />

                <RadioButton
                    android:id="@+id/mediumPizza"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medium (+$2.00)"
                    android:textColor="@color/white" />

                <RadioButton
                    android:id="@+id/largePizza"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Large (+$4.00)"
                    android:textColor="@color/white" />

            </RadioGroup>



            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose Crust"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp" />

            <RadioGroup
                android:id="@+id/crustGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/regularCrust"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Regular (+$0.00)"
                    android:textColor="@color/white" />

                <RadioButton
                    android:id="@+id/stuffedCrust"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stuffed (+$1.50)"
                    android:textColor="@color/white" />

            </RadioGroup>



            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quantity"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp" />

            <EditText
                android:id="@+id/quantityInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter quantity"
                android:inputType="number"
                android:textColor="@color/white"
                android:textColorHint="#DDDDDD" />


            <Button
                android:id="@+id/placeOrderButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Place Order"
                android:backgroundTint="#FFEB3B"
                android:textColor="@color/black"
                android:layout_marginTop="20dp" />



            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YOUR RECEIPT"
                android:textColor="@color/white"
                android:textSize="23sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="25dp" />

            <TextView
                android:id="@+id/receiptText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your receipt will appear here."
                android:textColor="@color/white"
                android:textSize="17sp"
                android:padding="15dp"
                android:background="#99000000" />

        </LinearLayout>

    </FrameLayout>

</ScrollView>
